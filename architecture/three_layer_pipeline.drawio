                </mxCell>
                <mxCell id="layer1" value="DistilBERT Binary Classifier&lt;br&gt;• Load model from cache (per subject)&lt;br&gt;• Tokenize question (max 128 tokens)&lt;br&gt;• Predict: RELATED / NOT_RELATED&lt;br&gt;• Keyword override for false negatives&lt;br&gt;• Accuracy: 99%+ | Latency: ~20ms" style="rounded=1;whiteSpace=wrap;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="275" y="185" width="300" height="100" as="geometry"/>
