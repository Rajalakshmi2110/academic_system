                <mxCell id="admin_ui" value="Admin UI: Add Subject&lt;br&gt;• Subject name, course code&lt;br&gt;• Upload syllabus.json&lt;br&gt;• Upload PDFs (textbooks, notes)&lt;br&gt;• Enable/disable auto-train" style="rounded=1;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
