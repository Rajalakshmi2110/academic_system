                <mxCell id="title" value="MODULE 6: RAG ANSWER GENERATION &amp; CONFIDENCE SCORING" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="175" y="70" width="500" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="input" value="Input: Validated Question from Module 5&lt;br&gt;(VALID or WARNING status)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="300" y="130" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="stage3_title" value="STAGE 3: RAG PIPELINE" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="300" y="200" width="250" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="retrieval" value="A. Retrieval (FAISS + SBERT)&lt;br&gt;• Embed question: 384-dim (all-MiniLM-L6-v2)&lt;br&gt;• FAISS semantic search (L2 distance)&lt;br&gt;• Retrieve top-3 chunks&lt;br&gt;• Source metadata: book name + page number&lt;br&gt;• Aggregate context: ~4500 chars&lt;br&gt;• Latency: ~50ms" style="rounded=1;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="300" y="250" width="250" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="generation" value="B. Generation (Ollama Llama 3.1 8B)&lt;br&gt;• Dynamic prompt template selection:&lt;br&gt;  - Document summary queries&lt;br&gt;  - Follow-up elaborations&lt;br&gt;  - Algorithm/pseudocode requests&lt;br&gt;  - General conceptual questions&lt;br&gt;• Local inference (max 500 tokens, temp 0.7)&lt;br&gt;• Context-grounded with grounding instructions&lt;br&gt;• Source page citations per response&lt;br&gt;• Latency: ~15-30s" style="rounded=1;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="300" y="420" width="250" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="confidence" value="C. Confidence Scoring (Hybrid Multi-Factor)&lt;br&gt;• 50%: Context-Answer overlap (words &gt; 3 chars)&lt;br&gt;• 30%: Question-Context relevance&lt;br&gt;• 20%: Answer completeness (20-300 words)&lt;br&gt;• Score: 0-100%&lt;br&gt;• Visual: 5 color-coded blocks&lt;br&gt;  (green ≥80%, orange ≥40%, red &lt;40%)&lt;br&gt;• Low confidence warning when &lt;60%" style="rounded=1;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="300" y="630" width="250" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="output" value="Output: Complete Response&lt;br&gt;• Answer text (markdown formatted)&lt;br&gt;• Confidence score (0-100%)&lt;br&gt;• Source citations (book + page number)&lt;br&gt;• Retrieved context chunks&lt;br&gt;• WARNING badge (if applicable)" style="rounded=1;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="300" y="810" width="250" height="120" as="geometry"/>
                </mxCell>
